{
  "name": "pageforge",
  "productName": "PageForge",
  "version": "0.1.1",
  "private": true,
  "description": "A local comic-book reader for CBZ/ZIP archives and image folders.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "main": "src/main/main.cjs",
  "scripts": {
    "start": "node scripts/launch.mjs",
    "test": "node --test \"test/*.test.js\"",
    "fixture": "node scripts/make-fixture.mjs",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm test && npm run verify:workflows && npm run smoke && npm run verify:crash",
    "predist": "node scripts/ensure-not-running.mjs",
    "dist": "electron-builder --win portable",
    "predist:dir": "node scripts/ensure-not-running.mjs",
    "dist:dir": "electron-builder --win --dir",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify:workflows": "node scripts/check-workflow-powershell.mjs .github/workflows/ci.yml && node scripts/check-workflow-powershell.mjs .github/workflows/release.yml",
    "verify:crash": "node scripts/verify-crash-report.mjs",
    "verify:archive": "node scripts/verify-archive.mjs"
  },
  "build": {
    "appId": "tools.pageforge.reader",
    "productName": "PageForge",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json",
      "README.md",
      "!test/**",
      "!docs/**",
      "!fixtures/**",
      "!release/**",
      "!scripts/**"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/7z-wasm/**",
      "node_modules/node-unrar-js/**"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "PageForge-${version}-portable.exe"
    }
  },
  "dependencies": {
    "7z-wasm": "^1.2.0",
    "node-unrar-js": "^2.0.2",
    "pdfjs-dist": "^6.4.299",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  }
}
